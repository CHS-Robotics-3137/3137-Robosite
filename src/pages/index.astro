---
/*
 * index.astro
 * The website's homepage
 * To test run: npm run dev
 * To build run: npm run build
 * reminder: pwa
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import ImageWindow from "../components/ImageWindow.astro";
import heroImage from "../assets/images/robots/2026-robot/robo-on-field-1.png";
import aboutWindowPhoto from "../assets/images/robots/2025-robot/robo-on-field-1.png";

const teamName = "T-Birds";
const teamNumber = 3137;
---

<BaseLayout title={`${teamName} - Home`}>
    <!-- Full-width opening photo with the team name layered over it. -->
    <section slot="hero" class="home-hero" aria-labelledby="hero-title">
        <!-- Optimizes the hero photo while preserving our CSS crop and position. -->
        <Image
            class="hero-image"
            src={heroImage}
            alt="Our team's robot on the competition field"
            format="webp"
            loading="eager"
            fetchpriority="high"
        />

        <!-- A dark overlay behind this content helps the text stay readable. -->
        <div class="hero-content">
            <p class="hero-team-number">FIRST Robotics Competition · Team {teamNumber}</p>
            <h1 id="hero-title" class="home-title">
                {teamName} ·<br>Connetquot Robotics
            </h1>
        </div>
    </section>

    <!-- Keep the remaining homepage content centered and comfortably spaced. -->
    <div class="home-content">
        <!-- Two columns on desktop; heading above text on phones. -->
        <section class="intro-section" aria-labelledby="about-title">
            <h2 id="about-title">About our team</h2>
            <!-- Keep the existing paragraphs together in the wider column. -->
            <div class="intro-copy">
                <p>
                    Connetquot Robotics, Team 3137, is our school's FIRST Robotics
                    Competition team.
                </p>
                <p>
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris hendrerit, dui a dapibus imperdiet, lectus ex efficitur odio, non luctus velit justo ac enim. Proin a luctus lectus, ut euismod eros. Donec iaculis volutpat ante, ut fermentum elit porttitor vitae. Aliquam vitae nunc ornare, fringilla purus eget, fringilla ex. In sed lacus condimentum, sodales felis sit amet, sodales turpis. Nam a ullamcorper leo. Nulla congue orci commodo eleifend mattis. Cras sagittis magna lacus, quis feugiat magna hendrerit ac. Phasellus lorem ex, convallis id neque vitae, tristique laoreet enim. Nulla elementum congue nunc vel iaculis. Vivamus suscipit nisl ac semper dignissim. Phasellus imperdiet vulputate metus, non dapibus eros feugiat vel. Quisque lobortis malesuada tempor. Praesent porttitor consequat risus.
                </p>
            </div> 
        </section>
    </div>

    <!-- Reusable photo window with this image's preferred crop position. -->
    <ImageWindow image={aboutWindowPhoto} position="center 60%" />

    <!-- Second solid panel completes the content-image-content sequence. -->
    <div class="home-content">
        <section class="intro-section" aria-labelledby="second-section-title">
            <h2 id="second-section-title">Lorem ipsum</h2>

            <!-- Placeholder copy; replace it when the section's purpose is decided. -->
            <div class="intro-copy">
                <p>
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam pellentesque vitae lacus et feugiat. Integer vel sem ut felis cursus rutrum. Donec in tellus consequat, posuere metus in, condimentum libero. Sed suscipit pharetra turpis. Quisque eu nisl ligula. Pellentesque quis auctor lectus. Maecenas mattis justo sit amet massa consectetur, vel pharetra metus euismod. Proin vitae scelerisque ligula. Quisque dolor ex, ultrices sed consectetur a, pharetra at sapien. Sed venenatis iaculis libero et ultricies.
                </p>
                <p>
                    Praesent in pharetra odio. Nulla velit velit, maximus eu sodales vitae, malesuada eu risus. Morbi eget dolor vitae sapien fringilla rutrum in id enim. Nam condimentum odio risus, ornare porta est malesuada vitae. Phasellus turpis felis, lacinia vel condimentum nec, fringilla eget quam. Integer luctus diam et efficitur semper. Praesent mollis pretium lorem, in consectetur quam condimentum quis. Morbi dapibus neque tellus, nec aliquet lacus vestibulum ac. Ut fringilla nibh eu blandit varius. Curabitur sed venenatis ipsum. Phasellus dignissim interdum odio, sit amet efficitur nisl dignissim vitae. Nam faucibus nunc at mollis lobortis. Sed tempus turpis et sapien posuere, non venenatis arcu pellentesque. Fusce egestas, diam ac sodales imperdiet, arcu neque pellentesque odio, et convallis purus orci consectetur ex.
                </p>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    /*
     * Homepage-specific layout, hero presentation, and mobile adjustments.
     * BaseLayout supplies the shared body styling.
     * Theme variables supply reusable colors, fonts, and navigation height.
     * Fixed hero contrast effects remain local to this file.
     */

    /* Fill most of the opening screen without inheriting section spacing. */
    .home-hero {
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: flex-end;
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        background-color: #202124;
        color: #fff;
    }

    /* Cover the banner while keeping the original photo proportions. */
    .hero-image {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;

        /* Change the second percentage to move the crop up or down. */
        object-position: center 38%;
    }

    /* Darken the lower portion so white text remains readable. */
    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            to bottom,
            rgb(0 0 0 / 10%) 20%,
            rgb(0 0 0 / 75%) 100%
        );
    }

    /* Align the hero text with the content below it. */
    .hero-content {
        box-sizing: border-box;
        width: 100%;
        max-width: 1148px;
        margin-inline: auto;
        padding: 64px 24px calc(64px + var(--nav-height));
    }

    /* Scale the heading to fit both narrow and wide screens. */
    .home-title {
        margin: 0 0 24px;
        max-width: 900px;
        font-family: var(--font-heading);
        font-size: clamp(2.5rem, 6vw, 5rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
    }

    /* Override the normal paragraph styling for text over the photo. */
    .hero-team-number {
        margin: 0 0 16px;
        color: #fff;
        font-size: clamp(0.85rem, 2vw, 1.1rem);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    /* Remove the heading's usual bottom gap inside the hero. */
    .home-hero .home-title {
        margin-bottom: 0;
    }

    /* Full-width solid panel; the inner section controls readable content width. */
    .home-content {
        background-color: var(--panel-background);
    }

    /* Keep the reference-style heading and text columns within a centered area. */
    .intro-section {
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(0, 0.36fr) minmax(0, 0.58fr);
        justify-content: space-between;
        gap: 40px;
        max-width: 1148px;
        margin-inline: auto;
        padding: 96px 24px;
    }

    /* Give the section heading its own smaller column. */
    .intro-section h2 {
        margin: 0;
        color: var(--panel-heading);
        font-family: var(--font-heading);
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        line-height: 1.2;
    }

    /* Override ordinary paragraph colors inside the dark content panel. */
    .intro-copy p {
        color: var(--panel-text);
    }

    /* Align the first paragraph with the top of the section heading. */
    .intro-copy p:first-child {
        margin-top: 0;
    }

    /* Avoid extra space after the final paragraph. */
    .intro-copy p:last-child {
        margin-bottom: 0;
    }

    /* Keep paragraphs readable rather than stretching across the screen. */
    p {
        max-width: 65ch;
        color: var(--color-text-muted);
        font-size: 1.1rem;
    }

    /* Darken the text area more on phones without changing desktop styling. */
    @media (max-width: 600px) {
        .home-hero::before {
            background: linear-gradient(
                to bottom,
                rgb(0 0 0 / 15%) 0%,
                rgb(0 0 0 / 55%) 45%,
                rgb(0 0 0 / 90%) 100%
            );
        }
        /* Stack the heading and copy when two columns would be too narrow. */
        .intro-section {
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
            padding: 64px 24px;
        }
    }

</style>