---
/*
 * index.astro
 * The website's homepage
 * To test run: npm run dev
 * To build run: npm run build
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/theme.css";
import { Image } from "astro:assets";
import heroImage from "../assets/images/robots/2026-robot/robo-on-field-1.png";

const teamName = "Connetquot Robotics";
const teamNumber = 3137;
---

<BaseLayout title={`${teamName} - Home`}>
    <!-- Full-width opening photo with the team name layered over it. -->
    <section slot="hero" class="home-hero" aria-labelledby="hero-title">
        <!-- Optimizes the hero photo while preserving our CSS crop and position. -->
        <Image
            class="hero-image"
            src={heroImage}
            alt="Our team's robot on the competition field"
            format="webp"
            loading="eager"
            fetchpriority="high"
        />

        <!-- A dark overlay behind this content helps the text stay readable. -->
        <div class="hero-content">
            <p class="hero-team-number">FIRST Robotics Competition · Team {teamNumber}</p>
            <h1 id="hero-title" class="home-title">{teamName}</h1>
        </div>
    </section>

    <!-- Keep the remaining homepage content centered and comfortably spaced. -->
    <div class="home-content">
        <section>
            <h2>About our team</h2>

            <p>
                Connetquot Robotics, Team 3137, is our school's FIRST Robotics
                Competition team.
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
                <br>
            </p>
        </section>
    </div>
</BaseLayout>

<style>
    /*
     * Homepage presentation.
     * Colors and fonts come from theme.css.
     * The body rule remains homepage specific for now.
     */
    :global(body:has(.home-content)) {
        margin: 0;
        min-height: 100vh;
        background-color: var(--color-background);
        color: var(--color-text);
        font-family: var(--font-body);
        line-height: 1.6;
    }

    /* Center the content area and keep text away from screen edges. */
    .home-content {
        max-width: 1100px;
        margin-inline: auto;
        padding: 64px 24px;
    }

    /* Scale the heading to fit both narrow and wide screens. */
    .home-title {
        margin: 0 0 24px;
        max-width: 900px;
        font-family: var(--font-heading);
        font-size: clamp(2.5rem, 6vw, 5rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
    }

    /* Keep paragraphs readable rather than stretching across the screen. */
    p {
        max-width: 65ch;
        color: var(--color-text-muted);
        font-size: 1.1rem;
    }

    /* Separate the introduction from the next section. */
    section {
        margin-top: 64px;
    }

    /* Fill most of the opening screen without inheriting section spacing. */
    .home-hero {
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: flex-end;
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        background-color: #202124;
        color: #fff;
    }

    /* Cover the banner while keeping the original photo proportions. */
    .hero-image {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;

        /* Change the second percentage to move the crop up or down. */
        object-position: center 38%;
    }

    /* Darken the lower portion so white text remains readable. */
    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            to bottom,
            rgb(0 0 0 / 10%) 20%,
            rgb(0 0 0 / 75%) 100%
        );
    }

    /* Align the hero text with the content below it. */
    .hero-content {
        box-sizing: border-box;
        width: 100%;
        max-width: 1148px;
        margin-inline: auto;
        padding: 64px 24px 128px;
    }

    /* Override the normal paragraph styling for text over the photo. */
    .hero-team-number {
        margin: 0 0 16px;
        color: #fff;
        font-size: clamp(0.85rem, 2vw, 1.1rem);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    /* Remove the heading's usual bottom gap inside the hero. */
    .home-hero .home-title {
        margin-bottom: 0;
    }

    /* The content container already provides space below the banner. */
    .home-content > section:first-child {
        margin-top: 0;
    }

</style>