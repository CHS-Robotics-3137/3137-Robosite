---
/*
 * index.astro
 * The website's homepage
 * To test run: npm run dev or npm run dev -- --host 0.0.0.0
 * To build run: npm run build
 * reminder: pwa
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImageWindow from "../components/ImageWindow.astro";
import ContentPanel from "../components/ContentPanel.astro";
import { parseHomepage } from "../lib/parseHomepage";
import { readHomepage } from "../lib/readHomepage";
import homeMarkdown from "../content/home.md?raw";

// Read editable hero settings separately from the Markdown section content.
const { settings: homeSettings, content: homeContent } =
    readHomepage(homeMarkdown);

// Make local photos available to Markdown without individual page imports.
// These imports provide image metadata; ImageWindow performs WebP optimization.
const photos = import.meta.glob<ImageMetadata>(
    "/src/assets/images/**/*.{png,jpg,jpeg,webp,avif}",
    { eager: true, import: "default" },
);
// Resolve the hero photo through the same local image library as photo windows.
const heroImage = photos[`/src/assets/images/${homeSettings.heroImage}`];

if (!heroImage) {
    throw new Error(
        `home.md: Hero photo "${homeSettings.heroImage}" was not found in src/assets/images. Check its path and capitalization.`,
    );
}

// Read sections in document order and resolve decorative photo references.
const homeSections = (await parseHomepage(homeContent)).map((section) => {
    if (section.type === "panel") return section;

    const image = photos[`/src/assets/images/${section.src}`];

    if (!image) {
        throw new Error(
            `home.md: Photo "${section.src}" was not found in src/assets/images. Check its path and capitalization.`,
        );
    }

    return { ...section, image };
});
---

<BaseLayout title={homeSettings.pageTitle}>
    <!-- Full-width opening photo with the team name layered over it. -->
    <section slot="hero" class="home-hero" aria-labelledby="hero-title">
        <!-- Optimizes the hero photo while preserving our CSS crop and position. -->
        <Image
            class="hero-image"
            src={heroImage}
            alt={homeSettings.heroAlt}
            style={{ objectPosition: homeSettings.heroPosition }}
            format="webp"
            loading="eager"
            fetchpriority="high"
        />

        <!-- A dark overlay behind this content helps the text stay readable. -->
        <!-- Editable hero words come from the settings in home.md. -->
        <div class="hero-content">
            <p class="hero-team-number">{homeSettings.heroSubtitle}</p>
            <h1 id="hero-title" class="home-title">
                {homeSettings.heroHeading}
            </h1>
        </div>
    </section>

    <!-- One Markdown document controls all sections below the hero. -->
    {
        homeSections.map((section, index) =>
            section.type === "panel" ? (
                <ContentPanel
                    heading={section.heading}
                    headingId={`home-panel-${index + 1}`}
                >
                    {/* HTML is generated from our local Markdown at build time. */}
                    <Fragment set:html={section.html} />
                </ContentPanel>
            ) : (
                <ImageWindow
                    image={section.image}
                    position={section.position}
                />
            ),
        )
    }

</BaseLayout>

<style>
    /*
     * Homepage-specific layout, hero presentation, and mobile adjustments.
     * BaseLayout supplies the shared body styling.
     * Theme variables supply reusable colors, fonts, and navigation height.
     * Fixed hero contrast effects remain local to this file.
     */

    /* Fill most of the opening screen without inheriting section spacing. */
    .home-hero {
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: flex-end;
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        background-color: #202124;
        color: #fff;
    }

    /* Cover the banner while keeping the original photo proportions. */
    .hero-image {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Darken the lower portion so white text remains readable. */
    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            to bottom,
            rgb(0 0 0 / 10%) 20%,
            rgb(0 0 0 / 75%) 100%
        );
    }

    /* Align the hero text with the content below it. */
    .hero-content {
        box-sizing: border-box;
        width: 100%;
        max-width: 1148px;
        margin-inline: auto;
        padding: 64px 24px calc(64px + var(--nav-height));
    }

    /* Scale the heading to fit both narrow and wide screens. */
    .home-title {
        margin: 0 0 24px;
        max-width: 900px;
        font-family: var(--font-heading);
        font-size: clamp(2.5rem, 6vw, 5rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
    }

    /* Override the normal paragraph styling for text over the photo. */
    .hero-team-number {
        margin: 0 0 16px;
        color: #fff;
        font-size: clamp(0.85rem, 2vw, 1.1rem);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    /* Remove the heading's usual bottom gap inside the hero. */
    .home-hero .home-title {
        margin-bottom: 0;
    }

    /* Darken the text area more on phones without changing desktop styling. */
    @media (max-width: 600px) {
        .home-hero::before {
            background: linear-gradient(
                to bottom,
                rgb(0 0 0 / 15%) 0%,
                rgb(0 0 0 / 55%) 45%,
                rgb(0 0 0 / 90%) 100%
            );
        }
    }
</style>