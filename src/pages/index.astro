---
/*
 * index.astro
 * The website's homepage
 * To test run: npm run dev or npm run dev -- --host 0.0.0.0
 * To build run: npm run build
 * reminder: pwa
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import ImageWindow from "../components/ImageWindow.astro";
import ContentPanel from "../components/ContentPanel.astro";

import heroImage from "../assets/images/robots/2026-robot/robo-on-field-1.png";
import aboutWindowPhoto from "../assets/images/robots/2025-robot/robo-on-field-1.png";
import pitWindowPhoto from "../assets/images/robots/2024-robot/robot-in-pit.png";

const teamName = "T-Birds";
const teamNumber = 3137;
---

<BaseLayout title={`${teamName} - Home`}>
    <!-- Full-width opening photo with the team name layered over it. -->
    <section slot="hero" class="home-hero" aria-labelledby="hero-title">
        <!-- Optimizes the hero photo while preserving our CSS crop and position. -->
        <Image
            class="hero-image"
            src={heroImage}
            alt="Our team's robot on the competition field"
            format="webp"
            loading="eager"
            fetchpriority="high"
        />

        <!-- A dark overlay behind this content helps the text stay readable. -->
        <div class="hero-content">
            <p class="hero-team-number">FIRST Robotics Competition · Team {teamNumber}</p>
            <h1 id="hero-title" class="home-title">
                {teamName} ·<br>Connetquot Robotics
            </h1>
        </div>
    </section>

    <!-- Reusable panel; its component handles layout and mobile spacing. -->
    <ContentPanel heading="About our team" headingId="about-title">
        <p>
            Connetquot Robotics, Team 3137, is our school's FIRST Robotics
            Competition team.
        </p>
        <p>
