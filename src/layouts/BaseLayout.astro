---
/**
 * BaseLayout.astro
 * Shared HTML document structure, navigation, and instant theme selection.
 */
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ThemeDecorations from "../components/ThemeDecorations.astro";
import { readTheme } from "../lib/readTheme";
import themeMarkdown from "../content/theme.md?raw";
import themeCss from "../styles/theme.css?raw";
import "../styles/theme.css";

interface Props {
    title?: string;
    description?: string;
}

const { title = "Our Robotics Team", description } = Astro.props;
const hasHero = Astro.slots.has("hero");
const themeRegistry = readTheme(themeMarkdown, themeCss);
const themeBootJson = JSON.stringify(themeRegistry).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme={themeRegistry.fallbackTheme}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={Astro.url.href} />
        <link
            rel="icon"
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/favicon.ico`}
            sizes="any"
        />
        <script is:inline define:vars={{ themeBootJson }}>
            (function () {
                var root = document.documentElement;
                root.classList.add("js");
                var cfg = JSON.parse(themeBootJson);
                var key = "team3137-active-theme";
                var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
                var isReload = nav && nav.type === "reload";
                var picked = null;

                try {
                    if (!isReload) picked = sessionStorage.getItem(key);
                } catch (_) {}

                if (!picked || cfg.allThemes.indexOf(picked) === -1) {
                    var month = new Date().getMonth();
                    var base = cfg.mode === "auto" ? (cfg.monthMap[month] || "default") : cfg.mode;
                    if (cfg.allThemes.indexOf(base) === -1) base = "default";
                    var others = cfg.allThemes.filter(function (t) { return t !== base; });
                    picked = others.length > 0 && Math.random() < cfg.randomChance
                        ? others[Math.floor(Math.random() * others.length)]
                        : base;
                    try {
                        sessionStorage.setItem(key, picked);
                    } catch (_) {}
                }

                root.dataset.theme = picked;
                var fontUrl = cfg.fontsByTheme[picked];
                if (fontUrl) {
                    var link = document.createElement("link");
                    link.rel = "stylesheet";
                    link.href = fontUrl;
                    document.head.appendChild(link);
                }
            })();
        </script>
    </head>
    <body>
        <slot name="hero" />

        <div
            class:list={[
                "sticky-navigation",
                { "overlaps-hero": hasHero },
            ]}
        >
            <Navigation />
            <ThemeDecorations themes={themeRegistry.allThemes} />
        </div>

        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    /*
     * Shared page foundation.
     * Apply the same background, text color, and body font on every page.
     */
    :global(body) {
        margin: 0;
        min-height: 100vh;
        background-color: var(--color-background);
        color: var(--color-text);
        font-family: var(--font-body);
        line-height: 1.6;
    }

    /* Keep navigation above page content once scrolling brings it to the top. */
    .sticky-navigation {
        position: sticky;
        top: 0;
        z-index: 100;
    }

    /* Pull navigation over the hero only on pages that supply the hero slot. */
    .sticky-navigation.overlaps-hero {
        margin-top: calc(-1 * var(--nav-height));
    }
</style>