---
/**
 * BaseLayout.astro
 * Shared HTML document structure for the website
 * Provides page metadata, navigation, and a place for each page's content
 */
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "../styles/theme.css";

// Pages may supply a browser-tab title; otherwise use this default
const { title = "Our Robotics Team" } = Astro.props;
// A supplied hero slot means navigation should overlap its bottom edge.
const hasHero = Astro.slots.has("hero");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <!-- Allow the layout to adapt to the device's screen width -->
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <!-- Use the favicon -->
        <link
            rel="icon"
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/favicon.ico`}
            sizes="any"
        />
    </head>
    <body>
        <!-- Pages can supply an opening hero above the shared navigation. -->
        <slot name="hero" />

        <!-- Stick to the top once scrolling brings the navigation there. -->
        <div
            class:list={[
                "sticky-navigation",
                { "overlaps-hero": hasHero },
            ]}
        >
            <Navigation />
        </div>

        <main>
            <!-- Insert the rest of the individual page's content here. -->
            <slot />
        </main>
        <!-- Show the manually maintained update year on every page. -->
        <Footer />
    </body>
</html>

<style>
    /*
     * Shared page foundation.
     * Apply the same background, text color, and body font on every page.
     */
    :global(body) {
        margin: 0;
        min-height: 100vh;
        background-color: var(--color-background);
        color: var(--color-text);
        font-family: var(--font-body);
        line-height: 1.6;
    }

    /* Keep navigation above page content once scrolling brings it to the top. */
    .sticky-navigation {
        position: sticky;
        top: 0;
        z-index: 100;
    }

    /* Pull navigation over the hero only on pages that supply the hero slot. */
    .sticky-navigation.overlaps-hero {
        margin-top: calc(-1 * var(--nav-height));
    }
</style>