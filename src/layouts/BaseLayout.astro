---
/**
 * BaseLayout.astro
 * Shared HTML document structure for the website
 * Provides page metadata, navigation, and a place for each page's content
 */
import Navigation from "../components/Navigation.astro";
import "../styles/theme.css";

// Pages may supply a browser-tab title; otherwise use this default
const { title = "Our Robotics Team" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <!-- Allow the layout to adapt to the device's screen width -->
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <!-- Use the favicon -->
        <link
            rel="icon"
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/favicon.ico`}
            sizes="any"
        />
    </head>
    <body>
        <!-- Pages can supply an opening hero above the shared navigation. -->
        <slot name="hero" />

        <!-- Stick to the top once scrolling brings the navigation there. -->
        <div class="sticky-navigation">
            <Navigation />
        </div>

        <main>
            <!-- Insert the rest of the individual page's content here. -->
            <slot />
        </main>
    </body>
</html>

<style>
    /* Keep navigation visible above page content once it reaches the top. */
    .sticky-navigation {
        position: sticky;
        top: 0;
        z-index: 100;
    }
    /* Overlap the full-height homepage photo without affecting other pages. */
    :global(body:has(.home-hero)) .sticky-navigation {
        margin-top: calc(-1 * var(--nav-height));
    }
    /* Darken the text area more on phones without changing desktop styling. */
    @media (max-width: 600px) {
        .home-hero::before {
            background: linear-gradient(
                to bottom,
                rgb(0 0 0 / 15%) 0%,
                rgb(0 0 0 / 55%) 45%,
                rgb(0 0 0 / 90%) 100%
            );
        }
    }
</style>