---
/*
 * ContentPanel.astro
 * A reusable dark content panel with a heading beside its content.
 * Stacks the heading above the content on smaller screens.
 */

interface Props {
    heading: string;
    headingId: string;
}

const { heading, headingId } = Astro.props;
---

<section class="content-panel" aria-labelledby={headingId}>
    <div class="panel-inner">
        <h2 id={headingId}>{heading}</h2>

        <!-- Accept custom content without rebuilding the panel's layout. -->
        <div class="panel-copy">
            <slot />
        </div>
    </div>
</section>

<style>
    /* Full-width dark surface, using the shared seasonal theme colors. */
    .content-panel {
        background-color: var(--panel-background);
    }

    /* Center the content and give the heading its own narrower column. */
    .panel-inner {
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(0, 0.36fr) minmax(0, 0.58fr);
        justify-content: space-between;
        gap: 40px;
        max-width: 1148px;
        margin-inline: auto;
        padding: 96px 24px;
    }

    /* Keep every panel heading consistent without styling other headings. */
    h2 {
        margin: 0;
        color: var(--panel-heading);
        font-family: var(--font-heading);
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        line-height: 1.2;
    }

    /* Shared typography for all Markdown content inside a panel. */
    .panel-copy {
        min-width: 0;
        color: var(--panel-text);
        font-size: 1.1rem;
        overflow-wrap: anywhere;
    }

    /* Keep paragraphs comfortably readable on wide screens. */
    .panel-copy :global(p) {
        max-width: 65ch;
    }

    /* Style Markdown subheadings without changing the panel's main heading. */
    .panel-copy :global(h3),
    .panel-copy :global(h4),
    .panel-copy :global(h5),
    .panel-copy :global(h6) {
        color: var(--panel-heading);
        font-family: var(--font-subheading);
        line-height: 1.3;
        margin-block: 1.5em 0.6em;
    }

    /* Keep links readable on dark backgrounds and identifiable without color. */
    .panel-copy :global(a) {
        color: var(--panel-heading);
        text-decoration: underline;
        text-underline-offset: 0.18em;
    }

    /* Make keyboard focus visible without changing the document layout. */
    .panel-copy :global(a:focus-visible) {
        outline: 2px solid currentColor;
        outline-offset: 4px;
    }

    /* Indent lists and provide breathing room between their items. */
    .panel-copy :global(ul),
    .panel-copy :global(ol) {
        padding-inline-start: 1.5em;
    }

    .panel-copy :global(li + li) {
        margin-top: 0.4em;
    }

    /* Distinguish quotations with a subtle rule instead of another surface. */
    .panel-copy :global(blockquote) {
        margin-inline: 0;
        padding-inline-start: 1em;
        border-inline-start: 3px solid var(--panel-text);
        font-style: italic;
    }

    /* A Markdown horizontal rule divides content within the same panel. */
    .panel-copy :global(hr) {
        border: 0;
        border-top: 1px solid var(--panel-text);
        margin-block: 2em;
    }

    /* Scroll long code examples inside their box, not across the whole page. */
    .panel-copy :global(pre) {
        max-width: 100%;
        overflow-x: auto;
        padding-block: 1em;
        white-space: pre;
        overflow-wrap: normal;
    }

    /* Keep ordinary content images within the panel's width. */
    .panel-copy :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
    }

    /* Remove outside spacing regardless of the first or last Markdown element. */
    .panel-copy > :global(:first-child) {
        margin-top: 0;
    }

    .panel-copy > :global(:last-child) {
        margin-bottom: 0;
    }

    /* Stack the heading and content on phones. */
    @media (max-width: 600px) {
        .panel-inner {
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
            padding: 64px 24px;
        }
    }
</style>