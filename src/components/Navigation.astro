---
/*
 * Navigation.astro
 * Shared navigation with active-page indicators and a looping team logo.
 * Colors, fonts, and navigation dimensions come from theme.css.
 */

// Keep links and public image URLs compatible with GitHub Pages.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${base}/`;

// Normalize trailing slashes so active-page comparisons stay consistent.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
    { label: "Home", href: homeUrl },
    { label: "Robots", href: `${base}/robots/` },
    { label: "Sponsors", href: `${base}/sponsors/` },
];
---

<nav class="team-navigation" aria-label="Main navigation">
    <!-- For now, the team logo links home; its action will change to something fun. -->
    <a class="team-logo" href={homeUrl} aria-label="Team 3137 home">
        <!-- Serve the animated WebP unchanged; data-image-component skips Astro's image suggestion. -->
        <img
            data-image-component 
            src={`${base}/images/branding/Nav_Loop.webp`}
            alt=""
            width="640"
            height="640"
        />
    </a>

    <!-- Distribute the links across the space remaining beside the logo. -->
    <div class="navigation-links">
        {
            links.map(({ label, href }) => (
                <a
                    href={href}
                    aria-current={
                        currentPath === (href.replace(/\/$/, "") || "/")
                            ? "page"
                            : undefined
                    }
                >
                    {label}
                </a>
            ))
        }
    </div>
</nav>

<style>
    /* Use the same height variable as the homepage's navigation overlap. */
    .team-navigation {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: clamp(12px, 3vw, 40px);
        height: var(--nav-height);
        padding-inline: clamp(12px, 3vw, 40px);
        background: var(--nav-background);
        color: var(--nav-text);
        font-family: var(--font-body);
    }

    /* Keep the square logo large enough to recognize without stretching it. */
    .team-logo {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        width: 64px;
        height: 64px;
    }

    .team-logo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    /* Equal-width link areas keep the three page links evenly distributed. */
    .navigation-links {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: center;
        flex: 1;
        min-width: 0;
    }

    .navigation-links a {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        color: var(--nav-text);
        font-size: var(--nav-font-size);
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
        text-underline-offset: 8px;
        text-decoration-thickness: 2px;
    }

    /* Identify the active page, and provide clear pointer feedback. */
    .navigation-links a[aria-current="page"],
    .navigation-links a:hover {
        text-decoration: underline;
    }

    /* Keep keyboard navigation visible on both the logo and page links. */
    a:focus-visible {
        outline: 2px solid var(--nav-text);
        outline-offset: 3px;
        border-radius: 2px;
    }

    /* Use equal gaps between the logo and links on narrow screens. */
    @media (max-width: 480px) {
        .team-navigation {
            justify-content: space-between;
            gap: 0;
        }

        .team-logo {
            width: 48px;
            height: 48px;
        }

        /* Place the links directly into the navbar's flex layout. */
        .navigation-links {
            display: contents;
        }

        .navigation-links a {
            flex: 0 0 auto;
        }
    }
</style>