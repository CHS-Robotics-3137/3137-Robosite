---
/*
 * Navigation.astro
 * Shared navigation with active-page indicators and a looping team logo.
 * Colors, fonts, and navigation dimensions come from theme.css.
 */

// Keep links and public image URLs compatible with GitHub Pages.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${base}/`;

// Normalize trailing slashes so active-page comparisons stay consistent.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
    { label: "Home", href: homeUrl },
    { label: "Robots", href: `${base}/robots/` },
    { label: "Gallery", href: `${base}/gallery/` },
    { label: "Sponsors", href: `${base}/sponsors/` },
];
---

<nav class="team-navigation" aria-label="Main navigation">
    <!-- For now, the team logo links home; its action will change to something fun. -->
    <a class="team-logo" href={homeUrl} aria-label="Team 3137 home">
        <!-- Serve the animated WebP unchanged; data-image-component skips Astro's image suggestion. -->
        <img
            data-image-component 
            src={`${base}/images/branding/Nav_Loop.webp`}
            alt=""
            width="640"
            height="640"
        />
    </a>

    <!-- Distribute the links across the space remaining beside the logo. -->
    <div class="navigation-links">
        {
            links.map(({ label, href }) => (
                <a
                    href={href}
                    aria-current={
                        currentPath === (href.replace(/\/$/, "") || "/")
                            ? "page"
                            : undefined
                    }
                >
                    {label}
                </a>
            ))
        }
    </div>

    <!-- Native expandable phone menu; desktop links remain unchanged. -->
    <details class="mobile-menu">
        <summary>Menu</summary>

        <div class="mobile-menu-links">
            {
                links.map(({ label, href }) => (
                    <a
                        href={href}
                        aria-current={
                            currentPath === (href.replace(/\/$/, "") || "/")
                                ? "page"
                                : undefined
                        }
                    >
                        {label}
                    </a>
                ))
            }
        </div>
    </details>
</nav>

<style>
    /* Use the same height variable as the homepage's navigation overlap. */
    .team-navigation {
        position: relative;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: clamp(12px, 3vw, 40px);
        height: var(--nav-height);
        padding-inline: clamp(12px, 3vw, 40px);
        background: var(--nav-background);
        color: var(--nav-text);
        font-family: var(--font-body);
    }

    /* Keep the square logo large enough to recognize without stretching it. */
    .team-logo {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        width: 64px;
        height: 64px;
    }

    .team-logo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    /* Equal-width link areas keep the three page links evenly distributed. */
    .navigation-links {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
        align-items: center;
        flex: 1;
        min-width: 0;
    }

    .navigation-links a {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        color: var(--nav-text);
        font-size: var(--nav-font-size);
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
        text-underline-offset: 8px;
        text-decoration-thickness: 2px;
    }

    /* Identify the active page, and provide clear pointer feedback. */
    .navigation-links a[aria-current="page"],
    .navigation-links a:hover {
        text-decoration: underline;
    }

    /* Keep keyboard navigation visible on both the logo and page links. */
    a:focus-visible {
        outline: 2px solid var(--nav-text);
        outline-offset: 3px;
        border-radius: 2px;
    }

    /* Desktop uses the existing spread-out links, not the expandable menu. */
    .mobile-menu {
        display: none;
    }

    /*
     * Phones show the logo and a comfortably sized Menu control.
     * The dropdown overlays content without changing the navbar height.
     */
    @media (max-width: 700px) {
        .team-navigation {
            justify-content: space-between;
            gap: 16px;
            padding-inline: 20px;
        }

        .team-logo {
            width: 48px;
            height: 48px;
        }

        .navigation-links {
            display: none;
        }

        .mobile-menu {
            display: block;
        }

        .mobile-menu summary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 44px;
            padding-inline: 12px;
            border: 1px solid currentColor;
            border-radius: 8px;
            color: var(--nav-text);
            font-size: 1rem;
            font-weight: 700;
            list-style: none;
            cursor: pointer;
        }

        /* Replace the browser marker with a consistent visual indicator. */
        .mobile-menu summary::-webkit-details-marker {
            display: none;
        }

        .mobile-menu summary::after {
            content: "+";
            font-size: 1.3rem;
            line-height: 1;
        }

        .mobile-menu[open] summary::after {
            content: "−";
        }

        .mobile-menu summary:focus-visible {
            outline: 2px solid var(--nav-text);
            outline-offset: 3px;
        }

        .mobile-menu-links {
            position: absolute;
            top: 100%;
            right: 0;
            left: 0;
            z-index: 1;
            display: grid;
            gap: 4px;
            padding: 12px 20px 20px;
            background: var(--nav-background);
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.2);
        }

        .mobile-menu-links a {
            display: flex;
            align-items: center;
            min-height: 48px;
            padding-inline: 12px;
            border-radius: 6px;
            color: var(--nav-text);
            font-size: var(--nav-font-size);
            font-weight: 700;
            text-decoration: none;
            text-underline-offset: 6px;
        }

        .mobile-menu-links a[aria-current="page"],
        .mobile-menu-links a:hover {
            text-decoration: underline;
            background: rgba(255, 255, 255, 0.08);
        }
    }
</style>