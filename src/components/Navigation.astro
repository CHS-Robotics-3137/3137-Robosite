---
/*
 * Navigation.astro
 * Shared navigation links for the website.
 * Imported by BaseLayout so navigation only needs to be maintained here
 */

// Read the configured site path and remove any trailing slash
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<nav aria-label="Main navigation">
    <!-- Include the repository path so links work on GitHub Pages. -->
    <a href={`${base}/`}>Home</a>
    <a href={`${base}/robots/`}>Robots</a>
    <a href={`${base}/sponsors/`}>Sponsors</a>
</nav>

<style>
    nav {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        padding: 16px;
        background: #142236;
    }

    a {
        color: #8cf2c3;
        font-family: system-ui, sans-serif;
        font-weight: bold;
        text-decoration: none;
    }

    a:hover,
    a:focus-visible {
        text-decoration: underline;
    }
</style>